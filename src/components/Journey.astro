---
import SectionHead from './SectionHead.astro';
import Bonfire from './Bonfire.astro';
import { journey as j } from '../data/content';
---
<section id="journey" class="mx-auto max-w-[1168px] border-t border-white/10 px-6 py-24 lg:px-0">
  <SectionHead n="03" label="JOURNEY" title={j.title} sub={j.sub} />
  <ol class="relative mt-12 space-y-6">
    <span class="absolute bottom-6 left-[15px] top-6 w-px bg-white/15" aria-hidden="true"></span>
    {j.items.map((it) => (
      <li class="relative grid grid-cols-[32px_1fr] gap-4 sm:gap-8">
        <span class="relative z-10 mt-6 grid h-8 place-items-start bg-abyss"><Bonfire lit={it.lit} size={3} class={it.lit ? 'flame' : ''} /></span>
        <article class="border border-white/10 bg-night p-6 sm:p-10">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-display text-xl uppercase text-bone sm:text-2xl">{it.role}</h3>
            <p class="text-sm text-ash">{it.date}</p>
          </div>
          <p class="mt-3 text-gold">{it.org}</p>
          <ul class="mt-6 space-y-1 text-ash">{it.bullets.map((b) => <li class="flex gap-2"><span aria-hidden="true">•</span>{b}</li>)}</ul>
        </article>
      </li>
    ))}
  </ol>
  <p class="mt-10 ml-12 inline-block border border-gold/40 bg-gold/5 px-12 py-4 font-display text-sm uppercase tracking-[.3em] text-gold sm:ml-[64px] sm:px-24 sm:py-5">{j.lit}</p>
</section>

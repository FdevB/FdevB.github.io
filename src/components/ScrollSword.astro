<div class="pointer-events-none fixed right-3 top-1/2 z-40 hidden h-[240px] w-4 -translate-y-1/2 lg:block" aria-hidden="true">
  <div class="absolute inset-y-0 left-1/2 w-px bg-white/10"></div>
  <div id="sword" class="absolute left-1/2 top-0 will-change-transform">
    <div class="mx-auto h-px w-3 bg-gold"></div>
    <div class="mx-auto h-[56px] w-px bg-gold shadow-[0_0_8px_var(--color-gold)]"></div>
  </div>
</div>
<script>
  const s = document.getElementById('sword');
  if (s) {
    const upd = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? scrollY / max : 0;
      s.style.transform = `translate(-50%, ${p * (240 - 58)}px)`;
    };
    addEventListener('scroll', upd, { passive: true }); upd();
  }
</script>

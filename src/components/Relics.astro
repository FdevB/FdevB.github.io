---
import SectionHead from './SectionHead.astro';
import PixelIcon from './PixelIcon.astro';
import { relics as r } from '../data/content';
const f = r.featured;
---
<section id="relics" class="mx-auto max-w-[1168px] border-t border-white/10 px-6 py-24 lg:px-0">
  <SectionHead n="04" label="RELICS" title={r.title} sub={r.sub} />

  <article class="relic mt-12 grid lg:grid-cols-[1fr_2fr]">
    <div class="flex flex-col justify-between gap-10 bg-abyss/60 p-8 sm:p-10">
      <PixelIcon i={1} class="size-20 text-gold" />
      <div>
        <p class="font-mono text-lg text-moon">{f.demo.req}</p>
        <p class="mt-4 font-pixel text-sm text-gold">{f.demo.res}</p>
        <p class="mt-6 border-t border-white/10 pt-4 font-pixel text-xs uppercase tracking-wider text-ash">{f.demo.note}</p>
      </div>
    </div>
    <div class="p-8 sm:p-10">
      <p class="font-pixel text-xs uppercase tracking-wider text-gold">Featured relic</p>
      <h3 class="mt-6 font-display text-2xl uppercase text-bone sm:text-4xl">{f.title}</h3>
      <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-ash">{f.desc}</p>
      <ul class="mt-8 flex flex-wrap gap-3">{f.tags.map((t) => <li class="chip">{t}</li>)}</ul>
      <p class="mt-8 font-pixel text-sm text-gold">{f.label}</p>
      <div class="mt-2 flex gap-8"><a class="link-out" href={f.live}>Live ↗</a><a class="link-out" href={f.github}>GitHub ↗</a></div>
    </div>
    <span class="corner-tr"></span><span class="corner-br"></span>
  </article>

  <div class="mt-8 grid gap-8 md:grid-cols-3">
    {r.items.map((it, i) => (
      <article class="relic flex flex-col p-6 sm:p-8">
        <div class="flex items-center gap-4"><PixelIcon i={i} class={i === 1 ? 'text-moon' : 'text-gold'} /><span class="font-pixel text-xs uppercase tracking-wider text-gold">Relic 0{i + 2}</span></div>
        <h3 class="mt-8 font-display text-xl uppercase text-bone sm:text-2xl">{it.title}</h3>
        <p class="mt-6 flex-1 text-lg leading-relaxed text-ash">{it.desc}</p>
        <ul class="mt-8 flex flex-wrap gap-2">{it.tags.map((t) => <li class="chip !px-3 !py-1.5 !text-[13px]">{t}</li>)}</ul>
        <p class="mt-6 font-pixel text-xs text-gold">{it.label}</p>
        <div class="mt-1 flex gap-8"><a class="link-out" href={it.live}>Live ↗</a><a class="link-out" href={it.github}>GitHub ↗</a></div>
        <span class="corner-tr"></span><span class="corner-br"></span><span class="corner-bl"></span>
      </article>
    ))}
  </div>
</section>

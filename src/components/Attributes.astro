---
import SectionHead from './SectionHead.astro';
import PixelIcon from './PixelIcon.astro';
import { attributes as a } from '../data/content';
const SEG = 8;
---
<section id="attributes" class="mx-auto max-w-[1168px] border-t border-white/10 px-6 py-24 lg:px-0">
  <SectionHead n="02" label="ATTRIBUTES" title={a.title} sub={a.sub} />

  <div class="mt-12" id="equip">
    <div role="tablist" aria-label="Skill categories" class="grid grid-cols-3 border border-white/10 bg-night">
      {a.tabs.map((t, i) => (
        <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1}
          class="min-h-14 border-b-2 border-transparent px-4 text-[15px] text-ash transition-colors hover:text-bone aria-selected:border-ember aria-selected:text-gold">
          {t.label}
        </button>
      ))}
    </div>

    {a.tabs.map((t, i) => (
      <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0} class="skill-grid mt-6 grid grid-cols-2 gap-4">
        {t.skills.map((s, j) => {
          const filled = s.level ? Math.max(1, Math.round((s.level / a.max) * SEG)) : 0;
          const glow = t.tone === 'moon' ? 'rgb(111 143 203 / .55)' : 'rgb(232 131 42 / .5)';
          const text = t.tone === 'moon' ? 'text-moon' : 'text-gold';
          const bar = t.tone === 'moon' ? 'bg-moon' : 'bg-ember';
          return (
            <div class="skill group relative flex min-h-28 flex-col justify-between border border-white/10 bg-night p-4 sm:p-5" style={`--glow:${glow}`} tabindex="0">
              <div class="flex items-start justify-between">
                <PixelIcon i={j} class={text} />
                <span class={`font-pixel text-xl ${text}`}>{s.level ?? '–'}</span>
              </div>
              <div>
                <p class="mt-3 text-[15px] leading-snug text-bone">{s.name}</p>
                <div class="mt-4 grid grid-cols-8 gap-1" aria-hidden="true">
                  {Array.from({ length: SEG }, (_, k) => <span class={`h-[3px] ${k < filled ? bar : 'bg-white/10'}`}></span>)}
                </div>
              </div>
              <div role="tooltip" class="tip pointer-events-none absolute inset-x-0 bottom-full z-30 mb-3 translate-y-1 p-4 opacity-0 transition group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
                <p class="font-pixel text-xs uppercase tracking-wider text-gold">{s.name}</p>
                <p class="mt-2 text-[15px] text-bone">{s.flavor}</p>
                <p class="mt-1 text-sm text-ash">{s.use}</p>
              </div>
            </div>
          );
        })}
      </div>
    ))}
  </div>
  <p class="mt-12 font-pixel text-xs uppercase tracking-wider text-ash">{a.note}</p>
</section>

<script>
  const root = document.getElementById('equip')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const show = (t: HTMLButtonElement, focus = false) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
    if (focus) t.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => show(t));
    t.addEventListener('keydown', (e) => {
      const k = e.key;
      if (k === 'ArrowRight') show(tabs[(i + 1) % tabs.length], true);
      else if (k === 'ArrowLeft') show(tabs[(i - 1 + tabs.length) % tabs.length], true);
      else if (k === 'Home') show(tabs[0], true);
      else if (k === 'End') show(tabs[tabs.length - 1], true);
    });
  });
</script>
